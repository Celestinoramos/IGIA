# ─────────────────────────────────────────────────────────────────────────────
# OpenAI — conversation & decision engine
# Create the key at https://platform.openai.com/api-keys in a SEPARATE project,
# with a Restricted permission, and set a monthly hard limit under
# Settings → Limits. Leave OPENAI_API_KEY empty to run with the deterministic
# mock engine (no network calls, no cost) — useful for local development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
# The system pauses automatically when the month's estimated spend reaches this.
OPENAI_MONTHLY_BUDGET_USD=50

# ─────────────────────────────────────────────────────────────────────────────
# Browser (first contact via the operator's real Chrome, over CDP)
# The debug port grants full control of the logged-in session. Keep it on
# 127.0.0.1 — NEVER 0.0.0.0, never on a shared machine. See SETUP.md.
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile
# "simulated" runs the full browser layer against mock pages / a fake CDP client
# (safe in containers). Switch to "real" only on the operator's machine.
BROWSER_DRIVER=simulated
# When true, the browser layer stops right before the final send (dry-run).
DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────────
# Meta Instagram — official API + webhook (continuation after the lead replies)
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_BASE=https://graph.instagram.com/v23.0

# ─────────────────────────────────────────────────────────────────────────────
# Database (SQLite is the single source of truth for the MVP)
DATABASE_URL=file:./data/app.db

# ─────────────────────────────────────────────────────────────────────────────
# Human pacing & rate limits (account health, not detection evasion)
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# ─────────────────────────────────────────────────────────────────────────────
# Encryption key (32+ chars) for browser session/state at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATE_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Worker tuning
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=1500
# Scales all human-pacing delays (1 = real time). Keep at 1 in production.
PACING_TIME_SCALE=1
